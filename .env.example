# Genera una clave larga y aleatoria; no uses este texto como valor real.
SECRET_KEY=pon_aqui_una_clave_segura

# Se usa únicamente para crear el usuario admin la primera vez.
ADMIN_PASSWORD=pon_aqui_una_contrasena_segura

# Integraciones opcionales. OdontoSpace las mostrará como pendientes hasta configurarlas.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
# Ejemplo Brevo: smtp-relay.brevo.com, puerto 587 y STARTTLS.
SMTP_HOST=smtp-relay.brevo.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OdontoSpace <correo-verificado@dominio.com>
SMTP_PORT=587
SMTP_USE_TLS=true
DIAN_PROVIDER_URL=
DIAN_API_KEY=
RIPS_PROVIDER_URL=
RIPS_API_KEY=
OPENAI_API_KEY=
